---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import RecentWork from '../components/RecentWork.astro';
import Reviews from '../components/Reviews.astro';
import { PHONE_DISPLAY, PHONE_TEL, coverageAreas, trustPoints } from '../consts';

const services = [
  {
    title: 'Site Clearance',
    desc: 'Fast, fully-insured clearance of vegetation, debris and old structures — leaving your site ready to build.',
    icon: '🚧',
  },
  {
    title: 'House Foundations',
    desc: 'Precision-dug and levelled foundations built to spec and passed for building control, first time.',
    icon: '🏗️',
  },
  {
    title: 'Drainage & Utilities',
    desc: 'Storm water, soakaways, percolation and utility trenching completed to current regulations.',
    icon: '🚰',
  },
  {
    title: 'Plant & Digger Hire',
    desc: 'Modern excavators, dumpers and rollers — with or without an experienced certified operator.',
    icon: '🚜',
  },
];

const guarantees = [
  'Fully insured & certified drivers on every job',
  'Free, no-obligation site estimate within 24 hours',
  'Upfront, fixed-price quotes — no surprise invoices',
  'On-time start & finish dates, guaranteed in writing',
];

const quoteServices = ['Site Clearance', 'House Foundations', 'Drainage & Utilities', 'Plant & Digger Hire'];
---

<BaseLayout
  title="Groundworks Kildare | Site Clearance, Foundations & Drainage — G Construction"
  description="Groundworks in Kildare, South Dublin, Offaly and Laois: site clearance, house foundations, drainage and plant hire. Fully insured, fixed-price quotes within 24 hours."
  canonicalPath="/groundworks"
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-slate-950">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-blue-900/20 via-slate-950 to-slate-950"></div>

    <div class="relative max-w-7xl mx-auto px-4 pt-10 sm:pt-16 pb-16 sm:pb-24">
      <div class="flex justify-center mb-6">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-blue-800 bg-slate-900 px-4 py-1.5 text-xs sm:text-sm font-semibold text-brand-blue-400">
          📍 SERVING KILDARE • SOUTH DUBLIN • OFFALY • LAOIS
        </span>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div class="text-center lg:text-left">
          <div class="mb-4 flex justify-center lg:justify-start">
            <a href={`tel:${PHONE_TEL}`} class="inline-flex items-center gap-2 rounded-lg bg-brand-blue-400 px-5 py-2.5 text-sm font-bold text-slate-950 hover:bg-brand-blue-300 transition-colors">
              📞 Call Now: {PHONE_DISPLAY}
            </a>
          </div>
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight text-white">
            Professional Groundworks & Site Prep
            <span class="text-brand-blue-400">Done Right</span>
            — On Time & Guaranteed
          </h1>
          <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0">
            Site clearance, excavation, house foundations, drainage and plant hire — handled by a
            fully insured, certified crew. Get an
            <span class="text-white font-semibold">upfront, fixed-price quote</span> within 24 hours,
            so there are no surprises and no delays once we're on site.
          </p>

          <ul class="mt-8 space-y-3 max-w-xl mx-auto lg:mx-0">
            {guarantees.map((g) => (
              <li class="flex items-start gap-3 text-left">
                <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-brand-green-400/10 text-brand-green-400">✓</span>
                <span class="text-slate-200">{g}</span>
              </li>
            ))}
          </ul>

          <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
            <a href="#quick-quote" class="w-full sm:w-auto text-center rounded-lg bg-brand-blue-400 px-8 py-4 text-lg font-bold text-slate-950 hover:bg-brand-blue-300 transition-colors shadow-lg shadow-brand-blue-400/20">
              Get My Free Site Estimate
            </a>
            <a href={`tel:${PHONE_TEL}`} class="w-full sm:w-auto text-center rounded-lg border border-brand-blue-800 px-8 py-4 text-lg font-semibold text-brand-blue-400 hover:border-brand-blue-400 transition-colors">
              📞 Call {PHONE_DISPLAY}
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            No pressure. No obligation. If we can't beat your current quote, we'll tell you straight.
          </p>
        </div>

        <div id="quick-quote" class="scroll-mt-24">
          <QuoteForm formName="groundworks-quote" idPrefix="gq" heading="Get Your Free Quote" badge="24H RESPONSE" services={quoteServices} />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST BAR ============ -->
  <section class="border-y border-brand-blue-900 bg-slate-900/50">
    <div class="max-w-7xl mx-auto px-4 py-8 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
      {trustPoints.map((t) => (
        <div>
          <p class="text-3xl font-extrabold text-brand-blue-400">{t.value}</p>
          <p class="text-sm text-slate-400 mt-1">{t.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section id="services" class="max-w-7xl mx-auto px-4 py-16 sm:py-24">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">What We Do</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">Groundworks Services Built to Last</h2>
      <p class="mt-4 text-slate-400">
        From the first dig to the final grade — we handle every stage of your site prep with the
        same fixed-price guarantee.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((s) => (
        <div class="rounded-xl border border-brand-blue-800 bg-slate-900 p-6 hover:border-brand-blue-400/60 transition-colors">
          <div class="text-4xl mb-4">{s.icon}</div>
          <h3 class="text-lg font-bold text-white mb-2">{s.title}</h3>
          <p class="text-sm text-slate-400">{s.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-6 rounded-xl border border-brand-blue-800 bg-slate-900/60 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="text-lg font-bold text-white mb-1">Planning an extension or garden room?</h3>
        <p class="text-sm text-slate-400">Extensions, garden rooms, renovations & conversions.</p>
      </div>
      <a href="/" class="flex-none rounded-lg border border-brand-blue-800 px-5 py-3 text-sm font-semibold text-brand-blue-400 hover:border-brand-blue-400 transition-colors">
        View Extensions Services →
      </a>
    </div>
  </section>

  <RecentWork prefix="groundworks" provided={3} />

  <!-- ============ WHY CHOOSE US / GUARANTEE ============ -->
  <section class="bg-slate-900 border-y border-brand-blue-900">
    <div class="max-w-7xl mx-auto px-4 py-16 sm:py-24 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">The G Construction Guarantee</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">We Take the Risk, Not You</h2>
        <p class="mt-4 text-slate-400">
          Too many groundworks jobs run over budget and over time. We fix that with a simple promise:
          a fixed, written quote before we touch the ground, and a start-to-finish date we stick to.
        </p>

        <div class="mt-8 space-y-4">
          <div class="flex items-start gap-4">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-brand-blue-400 text-slate-950 font-bold">1</span>
            <div>
              <h3 class="font-bold text-white">Free Site Estimate, Within 24 Hours</h3>
              <p class="text-sm text-slate-400">We visit, assess, and get you a straight answer fast — no waiting weeks.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-brand-blue-400 text-slate-950 font-bold">2</span>
            <div>
              <h3 class="font-bold text-white">Fixed-Price, Written Quote</h3>
              <p class="text-sm text-slate-400">No hidden extras. The price we agree is the price you pay.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-brand-blue-400 text-slate-950 font-bold">3</span>
            <div>
              <h3 class="font-bold text-white">On-Time, Every Time</h3>
              <p class="text-sm text-slate-400">Certified drivers, modern plant, and a crew that shows up when we say we will.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-brand-blue-800 bg-slate-950 p-8">
        <h3 class="text-xl font-bold text-white mb-6">Fully Insured & Certified</h3>
        <ul class="space-y-4">
          <li class="flex items-center gap-3">
            <span class="text-brand-green-400 text-xl">✓</span>
            <span class="text-slate-200">Public liability insurance on every job</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-brand-green-400 text-xl">✓</span>
            <span class="text-slate-200">Certified plant operators & drivers</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-brand-green-400 text-xl">✓</span>
            <span class="text-slate-200">Compliant with current building & drainage regs</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-brand-green-400 text-xl">✓</span>
            <span class="text-slate-200">Local crew — we know Kildare, South Dublin, Offaly & Laois</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ============ COVERAGE AREAS ============ -->
  <section id="coverage" class="max-w-7xl mx-auto px-4 py-16 sm:py-24">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">Coverage Areas</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">Proudly Serving Kildare & Beyond</h2>
      <p class="mt-4 text-slate-400">
        Based locally and on the road daily across these counties — if you're nearby, we can be on
        site fast.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      {coverageAreas.map((area) => (
        <div class="rounded-xl border border-brand-blue-800 bg-slate-900 px-4 py-6 text-center hover:border-brand-blue-400/60 transition-colors">
          <span class="text-brand-blue-400 text-xl">📍</span>
          <p class="mt-2 font-semibold text-white">{area}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ DETAILED QUOTE FORM ============ -->
  <section id="detailed-quote" class="bg-slate-900 border-y border-brand-blue-900">
    <div class="max-w-4xl mx-auto px-4 py-16 sm:py-24">
      <div class="text-center mb-10">
        <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">Ready to Start?</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">Request a Detailed Site Quote</h2>
        <p class="mt-4 text-slate-400">
          Give us the full picture and we'll come back with a precise, fixed-price quote — usually
          within 24 hours of visiting site.
        </p>
      </div>

      <QuoteForm formName="groundworks-detailed-quote" idPrefix="gd" heading="Detailed Quote" services={quoteServices} detailed />
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="max-w-7xl mx-auto px-4 py-16 sm:py-24 text-center">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Don't Let a Bad Groundworks Job Cost You Later</h2>
    <p class="mt-4 text-slate-400 max-w-2xl mx-auto">
      The foundation stage sets the standard for everything built on top of it. Get it right the
      first time with a local, insured, guaranteed crew.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#quick-quote" class="w-full sm:w-auto rounded-lg bg-brand-blue-400 px-8 py-4 text-lg font-bold text-slate-950 hover:bg-brand-blue-300 transition-colors shadow-lg shadow-brand-blue-400/20">
        Get My Free Quote
      </a>
      <a href={`tel:${PHONE_TEL}`} class="w-full sm:w-auto rounded-lg border border-brand-blue-800 px-8 py-4 text-lg font-semibold text-brand-blue-400 hover:border-brand-blue-400 transition-colors">
        📞 Call {PHONE_DISPLAY}
      </a>
    </div>
  </section>
</BaseLayout>
