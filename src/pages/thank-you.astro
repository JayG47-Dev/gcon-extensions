---
import BaseLayout from '../layouts/BaseLayout.astro';
import { PHONE_DISPLAY, PHONE_TEL } from '../consts';
---

<BaseLayout
  title="Thank You | G Construction"
  description="Thanks for your enquiry — G Construction will call you back within 24 hours."
  canonicalPath="/thank-you"
>
  <meta slot="head" name="robots" content="noindex" />
  <section class="max-w-2xl mx-auto px-4 py-24 sm:py-32 text-center">
    <span class="flex h-16 w-16 mx-auto items-center justify-center rounded-full bg-brand-green-400/10 text-4xl">✓</span>
    <h1 class="mt-6 text-3xl sm:text-4xl font-extrabold text-white">Thanks — We've Got Your Message</h1>
    <p class="mt-4 text-lg text-slate-300">
      One of the team will call you back within 24 hours with a straight answer on your job.
    </p>
    <p class="mt-2 text-slate-400">
      Need us sooner? Give us a call directly.
    </p>

    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href={`tel:${PHONE_TEL}`} class="w-full sm:w-auto rounded-lg bg-brand-blue-400 px-8 py-4 text-lg font-bold text-slate-950 hover:bg-brand-blue-300 transition-colors shadow-lg shadow-brand-blue-400/20">
        📞 Call {PHONE_DISPLAY}
      </a>
      <a href="/" class="w-full sm:w-auto rounded-lg border border-brand-blue-800 px-8 py-4 text-lg font-semibold text-brand-blue-400 hover:border-brand-blue-400 transition-colors">
        Back to Home
      </a>
    </div>
  </section>
</BaseLayout>
