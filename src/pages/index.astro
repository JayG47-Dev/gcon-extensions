    <script>
      const ANNUAL_RELIEF = 14000;
      const costInput = document.getElementById('calc-cost') as HTMLInputElement | null;
      const sliderInput = document.getElementById('calc-cost-slider') as HTMLInputElement | null;
      const paybackEl = document.getElementById('calc-payback');
      const profitEl = document.getElementById('calc-profit');

      function formatEuro(n: number) {
        return '€' + Math.round(n).toLocaleString('en-IE');
      }

      function update(cost: number) {
        if (!paybackEl || !profitEl) return;
        cost = Math.max(0, cost);

        const totalMonths = Math.ceil((cost / ANNUAL_RELIEF) * 12);
        const years = Math.floor(totalMonths / 12);
        const months = totalMonths % 12;

        let paybackText = '';
        if (years === 0) {
          paybackText = `${months} month${months === 1 ? '' : 's'}`;
        } else if (months === 0) {
          paybackText = `${years} year${years === 1 ? '' : 's'}`;
        } else {
          paybackText = `${years} year${years === 1 ? '' : 's'} ${months} month${months === 1 ? '' : 's'}`;
        }
        paybackEl.textContent = paybackText;

        const tenYearProfit = ANNUAL_RELIEF * 10 - cost;
        if (tenYearProfit >= 0) {
          profitEl.textContent = `After 10 years, that's ${formatEuro(tenYearProfit)} kept — tax-free`;
          profitEl.classList.remove('text-slate-400');
          profitEl.classList.add('text-emerald-400');
        } else {
          profitEl.textContent = `Still ${formatEuro(Math.abs(tenYearProfit))} from breakeven at the 10-year mark`;
          profitEl.classList.remove('text-emerald-400');
          profitEl.classList.add('text-slate-400');
        }
      }

      if (costInput && sliderInput) {
        costInput.addEventListener('input', () => {
          const val = Number(costInput.value) || 0;
          const min = Number(sliderInput.min);
          const max = Number(sliderInput.max);
          if (val >= min && val <= max) {
            sliderInput.value = String(val);
          }
          update(val);
        });

        sliderInput.addEventListener('input', () => {
          costInput.value = sliderInput.value;
          update(Number(sliderInput.value));
        });

        update(Number(costInput.value));
      }
    </script>
  </body>
