---
import BaseLayout from '../layouts/BaseLayout.astro';
import QuoteForm from '../components/QuoteForm.astro';
import RecentWork from '../components/RecentWork.astro';
import Reviews from '../components/Reviews.astro';
import { PHONE_DISPLAY, PHONE_TEL, coverageAreas, trustPoints } from '../consts';

const services = [
  {
    title: 'House Extensions',
    desc: 'Single or two-storey extensions designed and built to add real space and real value to your home.',
    icon: '🏠',
  },
  {
    title: 'Garden Rooms & Cabins',
    desc: 'Self-contained garden rooms and cabins — ideal for a home office, gym, or tax-free rental income.',
    icon: '🛖',
  },
  {
    title: 'Renovations & Refurbishments',
    desc: 'Full home renovations and refurbishments, from a single room to a top-to-bottom refit.',
    icon: '🔨',
  },
  {
    title: 'Attic & Garage Conversions',
    desc: 'Turn unused attic or garage space into a proper, regulation-compliant living area.',
    icon: '🪜',
  },
];

const guarantees = [
  'Fully insured & certified builders on every job',
  'Free, no-obligation site consultation within 24 hours',
  'Upfront, fixed-price quotes — no surprise invoices',
  'On-time start & finish dates, guaranteed in writing',
];

const quoteServices = ['House Extension', 'Garden Room / Cabin', 'Renovation / Refurbishment', 'Attic / Garage Conversion'];
---

<BaseLayout
  title="G Construction | Extensions, Garden Rooms & Renovations"
  description="G Construction — house extensions, garden rooms, renovations and conversions across Kildare, South Dublin, Offaly and Laois. Free site consultations."
  canonicalPath="/"
>
  <!-- ============ HERO ============ -->
  <section class="relative overflow-hidden bg-slate-950">
    <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-blue-900/20 via-slate-950 to-slate-950"></div>

    <div class="relative max-w-7xl mx-auto px-4 pt-10 sm:pt-16 pb-16 sm:pb-24">
      <div class="flex justify-center mb-6">
        <span class="inline-flex items-center gap-2 rounded-full border border-brand-blue-800 bg-slate-900 px-4 py-1.5 text-xs sm:text-sm font-semibold text-brand-blue-400">
          📍 SERVING KILDARE • SOUTH DUBLIN • OFFALY • LAOIS
        </span>
      </div>

      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <div class="text-center lg:text-left">
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight text-white">
            Extensions, Garden Rooms &
            <span class="text-brand-blue-400">Renovations</span>
            — Done Right, On Budget
          </h1>
          <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0">
            From a garden cabin to a full home extension — handled by a fully insured, certified
            crew. Get an
            <span class="text-white font-semibold">upfront, fixed-price quote</span> within 24 hours,
            so there are no surprises and no delays once we're on site.
          </p>

          <ul class="mt-8 space-y-3 max-w-xl mx-auto lg:mx-0">
            {guarantees.map((g) => (
              <li class="flex items-start gap-3 text-left">
                <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-brand-green-400/10 text-brand-green-400">✓</span>
                <span class="text-slate-200">{g}</span>
              </li>
            ))}
          </ul>

          <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
            <a href="#quick-quote" class="w-full sm:w-auto text-center rounded-lg bg-brand-blue-400 px-8 py-4 text-lg font-bold text-slate-950 hover:bg-brand-blue-300 transition-colors shadow-lg shadow-brand-blue-400/20">
              Get My Free Consultation
            </a>
            <a href={`tel:${PHONE_TEL}`} class="w-full sm:w-auto text-center rounded-lg border border-brand-blue-800 px-8 py-4 text-lg font-semibold text-brand-blue-400 hover:border-brand-blue-400 transition-colors">
              📞 Call {PHONE_DISPLAY}
            </a>
          </div>
          <p class="mt-4 text-sm text-slate-500">
            No pressure. No obligation. If we can't beat your current quote, we'll tell you straight.
          </p>
        </div>

        <div id="quick-quote" class="scroll-mt-24">
          <QuoteForm formName="home-quote" idPrefix="hq" heading="Get Your Free Quote" badge="24H RESPONSE" services={quoteServices} />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ GARDEN ROOM TAX CALCULATOR ============ -->
  <section class="border-y border-brand-blue-900 bg-slate-900/60">
    <div class="max-w-5xl mx-auto px-4 py-12 sm:py-16">
      <div class="rounded-2xl border border-brand-blue-800 bg-slate-900 p-6 sm:p-10 shadow-2xl">
        <div class="flex items-start gap-3 mb-3">
          <span class="text-2xl" aria-hidden="true">📌</span>
          <div>
            <span class="text-xs font-bold uppercase tracking-wider text-brand-blue-400">Quick Math</span>
            <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">Here's How The Numbers Break Down</h2>
          </div>
        </div>
        <p class="text-slate-400 mb-8 max-w-2xl">
          Ireland's Rent-a-Room Relief is being extended to cover garden rooms and cabins — letting
          you earn up to <span class="text-white font-semibold">€14,000 a year, completely tax-free</span>.
          Pop in a rough build cost below and see how fast it could pay for itself.
        </p>

        <div class="grid sm:grid-cols-2 gap-8 items-center">
          <div>
            <label for="calc-cost" class="block text-sm font-medium text-slate-300 mb-2">Estimated build cost</label>
            <div class="flex items-center gap-3">
              <span class="text-2xl font-bold text-brand-blue-400">€</span>
              <input id="calc-cost" type="number" min="10000" max="250000" step="1000" value="60000" class="w-full rounded-lg border border-brand-blue-800 bg-slate-950 px-4 py-3 text-xl font-bold text-white focus:border-brand-blue-400 focus:outline-none focus:ring-1 focus:ring-brand-blue-400" />
            </div>
            <input id="calc-cost-slider" type="range" min="10000" max="150000" step="1000" value="60000" class="w-full mt-4 accent-brand-blue-400" />
            <div class="flex justify-between text-xs text-slate-500 mt-1">
              <span>€10k</span>
              <span>€150k</span>
            </div>
          </div>

          <div class="rounded-xl bg-slate-950 border border-brand-blue-800 p-6 text-center">
            <p class="text-sm text-slate-400 mb-1">Paid off in</p>
            <p id="calc-payback" class="text-4xl font-extrabold text-brand-blue-400">—</p>
            <p id="calc-profit" class="text-sm font-semibold mt-3 text-emerald-400">—</p>
          </div>
        </div>

        <div class="mt-8 flex flex-col sm:flex-row items-center gap-4">
          <a href="#quick-quote" class="w-full sm:w-auto text-center rounded-lg bg-brand-blue-400 px-6 py-3 font-bold text-slate-950 hover:bg-brand-blue-300 transition-colors">
            Get a Garden Room Quote →
          </a>
          <p class="text-xs text-slate-500 max-w-md">
            Estimate only, for illustration. Based on current Rent-a-Room Relief rules (up to
            €14,000/year tax-free). Final Revenue conditions for garden/modular units are still being
            finalised and not yet confirmed law — ask us or your accountant for current guidance.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST BAR ============ -->
  <section class="border-y border-brand-blue-900 bg-slate-900/50">
    <div class="max-w-7xl mx-auto px-4 py-8 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
      {trustPoints.map((t) => (
        <div>
          <p class="text-3xl font-extrabold text-brand-blue-400">{t.value}</p>
          <p class="text-sm text-slate-400 mt-1">{t.label}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ SERVICES ============ -->
  <section id="services" class="max-w-7xl mx-auto px-4 py-16 sm:py-24">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">What We Do</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">Extensions & Renovations Built to Last</h2>
      <p class="mt-4 text-slate-400">
        From the first design chat to the final coat of paint — we handle every stage with the same
        fixed-price guarantee.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {services.map((s) => (
        <div class="rounded-xl border border-brand-blue-800 bg-slate-900 p-6 hover:border-brand-blue-400/60 transition-colors">
          <div class="text-4xl mb-4">{s.icon}</div>
          <h3 class="text-lg font-bold text-white mb-2">{s.title}</h3>
          <p class="text-sm text-slate-400">{s.desc}</p>
        </div>
      ))}
    </div>

    <div class="mt-6 rounded-xl border border-brand-blue-800 bg-slate-900/60 p-6 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div>
        <h3 class="text-lg font-bold text-white mb-1">Need groundworks or site prep instead?</h3>
        <p class="text-sm text-slate-400">Site clearance, foundations, drainage & plant hire.</p>
      </div>
      <a href="/groundworks" class="flex-none rounded-lg border border-brand-blue-800 px-5 py-3 text-sm font-semibold text-brand-blue-400 hover:border-brand-blue-400 transition-colors">
        View Groundworks Services →
      </a>
    </div>
  </section>

  <RecentWork prefix="home" provided={3} />

  <!-- ============ WHY CHOOSE US / GUARANTEE ============ -->
  <section class="bg-slate-900 border-y border-brand-blue-900">
    <div class="max-w-7xl mx-auto px-4 py-16 sm:py-24 grid lg:grid-cols-2 gap-12 items-center">
      <div>
        <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">The G Construction Guarantee</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">We Take the Risk, Not You</h2>
        <p class="mt-4 text-slate-400">
          Too many extension projects run over budget and over time. We fix that with a simple
          promise: a fixed, written quote before we touch the ground, and a start-to-finish date we
          stick to.
        </p>

        <div class="mt-8 space-y-4">
          <div class="flex items-start gap-4">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-brand-blue-400 text-slate-950 font-bold">1</span>
            <div>
              <h3 class="font-bold text-white">Free Site Consultation, Within 24 Hours</h3>
              <p class="text-sm text-slate-400">We visit, assess, and get you a straight answer fast — no waiting weeks.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-brand-blue-400 text-slate-950 font-bold">2</span>
            <div>
              <h3 class="font-bold text-white">Fixed-Price, Written Quote</h3>
              <p class="text-sm text-slate-400">No hidden extras. The price we agree is the price you pay.</p>
            </div>
          </div>
          <div class="flex items-start gap-4">
            <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-brand-blue-400 text-slate-950 font-bold">3</span>
            <div>
              <h3 class="font-bold text-white">On-Time, Every Time</h3>
              <p class="text-sm text-slate-400">Certified tradespeople and a crew that shows up when we say we will.</p>
            </div>
          </div>
        </div>
      </div>

      <div class="rounded-2xl border border-brand-blue-800 bg-slate-950 p-8">
        <h3 class="text-xl font-bold text-white mb-6">Fully Insured & Certified</h3>
        <ul class="space-y-4">
          <li class="flex items-center gap-3">
            <span class="text-emerald-400 text-xl">✓</span>
            <span class="text-slate-200">Public liability insurance on every job</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-emerald-400 text-xl">✓</span>
            <span class="text-slate-200">Certified tradespeople across every trade</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-emerald-400 text-xl">✓</span>
            <span class="text-slate-200">Compliant with current building regulations</span>
          </li>
          <li class="flex items-center gap-3">
            <span class="text-emerald-400 text-xl">✓</span>
            <span class="text-slate-200">Local crew — we know Kildare, South Dublin, Offaly & Laois</span>
          </li>
        </ul>
      </div>
    </div>
  </section>

  <Reviews />

  <!-- ============ COVERAGE AREAS ============ -->
  <section id="coverage" class="max-w-7xl mx-auto px-4 py-16 sm:py-24">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">Coverage Areas</span>
      <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">Proudly Serving Kildare & Beyond</h2>
      <p class="mt-4 text-slate-400">
        Based locally and on the road daily across these counties — if you're nearby, we can be on
        site fast.
      </p>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
      {coverageAreas.map((area) => (
        <div class="rounded-xl border border-brand-blue-800 bg-slate-900 px-4 py-6 text-center hover:border-brand-blue-400/60 transition-colors">
          <span class="text-brand-blue-400 text-xl">📍</span>
          <p class="mt-2 font-semibold text-white">{area}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- ============ DETAILED QUOTE FORM ============ -->
  <section id="detailed-quote" class="bg-slate-900 border-y border-brand-blue-900">
    <div class="max-w-4xl mx-auto px-4 py-16 sm:py-24">
      <div class="text-center mb-10">
        <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">Ready to Start?</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">Request a Detailed Project Quote</h2>
        <p class="mt-4 text-slate-400">
          Give us the full picture and we'll come back with a precise, fixed-price quote — usually
          within 24 hours of visiting site.
        </p>
      </div>

      <QuoteForm formName="home-detailed-quote" idPrefix="hd" heading="Detailed Quote" services={quoteServices} detailed />
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="max-w-7xl mx-auto px-4 py-16 sm:py-24 text-center">
    <h2 class="text-3xl sm:text-4xl font-extrabold text-white">Don't Let a Bad Extension Job Cost You Later</h2>
    <p class="mt-4 text-slate-400 max-w-2xl mx-auto">
      The build quality sets the standard for everything that happens in that space for years to
      come. Get it right the first time with a local, insured, guaranteed crew.
    </p>
    <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-4">
      <a href="#quick-quote" class="w-full sm:w-auto rounded-lg bg-brand-blue-400 px-8 py-4 text-lg font-bold text-slate-950 hover:bg-brand-blue-300 transition-colors shadow-lg shadow-brand-blue-400/20">
        Get My Free Quote
      </a>
      <a href={`tel:${PHONE_TEL}`} class="w-full sm:w-auto rounded-lg border border-brand-blue-800 px-8 py-4 text-lg font-semibold text-brand-blue-400 hover:border-brand-blue-400 transition-colors">
        📞 Call {PHONE_DISPLAY}
      </a>
    </div>
  </section>

  <script slot="scripts">
    const ANNUAL_RELIEF = 14000;
    const costInput = document.getElementById('calc-cost');
    const sliderInput = document.getElementById('calc-cost-slider');
    const paybackEl = document.getElementById('calc-payback');
    const profitEl = document.getElementById('calc-profit');

    function formatEuro(n) {
      return '€' + Math.round(n).toLocaleString('en-IE');
    }

    function update(cost) {
      if (!paybackEl || !profitEl) return;
      cost = Math.max(0, cost);

      const totalMonths = Math.ceil((cost / ANNUAL_RELIEF) * 12);
      const years = Math.floor(totalMonths / 12);
      const months = totalMonths % 12;

      let paybackText = '';
      if (years === 0) {
        paybackText = `${months} month${months === 1 ? '' : 's'}`;
      } else if (months === 0) {
        paybackText = `${years} year${years === 1 ? '' : 's'}`;
      } else {
        paybackText = `${years} year${years === 1 ? '' : 's'} ${months} month${months === 1 ? '' : 's'}`;
      }
      paybackEl.textContent = paybackText;

      const tenYearProfit = ANNUAL_RELIEF * 10 - cost;
      if (tenYearProfit >= 0) {
        profitEl.textContent = `After 10 years, that's ${formatEuro(tenYearProfit)} kept — tax-free`;
        profitEl.classList.remove('text-slate-400');
        profitEl.classList.add('text-emerald-400');
      } else {
        profitEl.textContent = `Still ${formatEuro(Math.abs(tenYearProfit))} from breakeven at the 10-year mark`;
        profitEl.classList.remove('text-emerald-400');
        profitEl.classList.add('text-slate-400');
      }
    }

    if (costInput && sliderInput) {
      costInput.addEventListener('input', () => {
        const val = Number(costInput.value) || 0;
        const min = Number(sliderInput.min);
        const max = Number(sliderInput.max);
        if (val >= min && val <= max) {
          sliderInput.value = String(val);
        }
        update(val);
      });

      sliderInput.addEventListener('input', () => {
        costInput.value = sliderInput.value;
        update(Number(sliderInput.value));
      });

      update(Number(costInput.value));
    }
  </script>
</BaseLayout>
