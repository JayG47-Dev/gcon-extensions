---
import '../styles/global.css';

const PHONE_DISPLAY = '087 9399373';
const PHONE_TEL = '0879399373';
const EMAIL = 'markggorman@gmail.com';

const services = [
  {
    title: 'House Extensions',
    desc: 'Single or two-storey extensions designed and built to add real space and real value to your home.',
    icon: '🏠',
  },
  {
    title: 'Garden Rooms & Cabins',
    desc: 'Self-contained garden rooms and cabins — ideal for a home office, gym, or tax-free rental income.',
    icon: '🛖',
  },
  {
    title: 'Renovations & Refurbishments',
    desc: 'Full home renovations and refurbishments, from a single room to a top-to-bottom refit.',
    icon: '🔨',
  },
  {
    title: 'Attic & Garage Conversions',
    desc: 'Turn unused attic or garage space into a proper, regulation-compliant living area.',
    icon: '🪜',
  },
];

const coverageAreas = ['Co. Kildare', 'Co. Dublin', 'Co. Offaly', 'The Midlands'];

const guarantees = [
  'Fully insured & certified builders on every job',
  'Free, no-obligation site consultation within 24 hours',
  'Upfront, fixed-price quotes — no surprise invoices',
  'On-time start & finish dates, guaranteed in writing',
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="G Construction — house extensions, garden rooms, renovations and conversions across Kildare, Dublin, Offaly and the Midlands. Free site consultations."
    />
    <title>G Construction | Extensions, Garden Rooms & Renovations</title>
    <link rel="icon" type="image/png" href="/logo-g-con.png" />
  </head>
  <body class="bg-slate-950 text-slate-100 antialiased pb-20 md:pb-0">
    <!-- ============ TOP STEEL-BLUE STRIP ============ -->
    <div class="bg-brand-blue-400 text-slate-950 text-xs sm:text-sm font-semibold">
      <div
        class="max-w-7xl mx-auto px-4 py-2 flex flex-wrap items-center justify-center gap-x-3 gap-y-1 text-center"
      >
        <span>★★★★★ 5.0 Star Rated Local Specialist</span>
        <span class="hidden sm:inline">|</span>
        <span>Fully Insured • Certified Builders • Free Site Consultations</span>
        <span class="hidden sm:inline">|</span>
        <a href={`tel:${PHONE_TEL}`} class="underline underline-offset-2 hover:no-underline">
          Call {PHONE_DISPLAY}
        </a>
      </div>
    </div>

    <!-- ============ HEADER ============ -->
    <header class="sticky top-0 z-40 bg-slate-950/95 backdrop-blur border-b border-brand-blue-900">
      <div class="max-w-7xl mx-auto px-4 py-3 flex items-center justify-between gap-4">
        <div class="flex items-center gap-3">
          <img src="/logo-g-con.png" alt="G Construction logo" class="h-14 w-14 sm:h-16 sm:w-16 object-contain rounded" />
          <span class="text-lg sm:text-2xl font-extrabold tracking-tight text-white">
            G Construction
          </span>
        </div>
        <div class="flex items-center gap-2 sm:gap-3">
          <a
            href={`tel:${PHONE_TEL}`}
            class="hidden sm:inline-flex items-center gap-2 rounded-lg border border-brand-blue-800 px-4 py-2 text-sm font-semibold text-brand-blue-400 hover:border-brand-blue-400 transition-colors"
          >
            📞 {PHONE_DISPLAY}
          </a>
          <a
            href="#quick-quote"
            class="inline-flex items-center gap-2 rounded-lg bg-brand-blue-400 px-4 py-2 text-sm sm:text-base font-bold text-slate-950 hover:bg-brand-blue-300 transition-colors shadow-lg shadow-brand-blue-400/20"
          >
            Get Free Quote
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- ============ HERO ============ -->
      <section class="relative overflow-hidden bg-slate-950">
        <div
          class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-brand-blue-900/20 via-slate-950 to-slate-950"
        >
        </div>

        <div class="relative max-w-7xl mx-auto px-4 pt-10 sm:pt-16 pb-16 sm:pb-24">
          <div class="flex justify-center mb-6">
            <span
              class="inline-flex items-center gap-2 rounded-full border border-brand-blue-800 bg-slate-900 px-4 py-1.5 text-xs sm:text-sm font-semibold text-brand-blue-400"
            >
              📍 SERVING KILDARE • DUBLIN • OFFALY • THE MIDLANDS
            </span>
          </div>

          <div class="grid lg:grid-cols-2 gap-12 items-start">
            <div class="text-center lg:text-left">
              <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold leading-tight text-white">
                Extensions, Garden Rooms &
                <span class="text-brand-blue-400">Renovations</span>
                — Done Right, On Budget
              </h1>
              <p class="mt-6 text-lg sm:text-xl text-slate-300 max-w-2xl mx-auto lg:mx-0">
                From a garden cabin to a full home extension — handled by a fully insured, certified
                crew. Get an
                <span class="text-white font-semibold">upfront, fixed-price quote</span> within 24 hours,
                so there are no surprises and no delays once we're on site.
              </p>

              <ul class="mt-8 space-y-3 max-w-xl mx-auto lg:mx-0">
                {guarantees.map((g) => (
                  <li class="flex items-start gap-3 text-left">
                    <span class="mt-0.5 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-brand-green-400/10 text-brand-green-400">
                      ✓
                    </span>
                    <span class="text-slate-200">{g}</span>
                  </li>
                ))}
              </ul>

              <div class="mt-8 flex flex-col sm:flex-row items-center gap-4 justify-center lg:justify-start">
                <a
                  href="#quick-quote"
                  class="w-full sm:w-auto text-center rounded-lg bg-brand-blue-400 px-8 py-4 text-lg font-bold text-slate-950 hover:bg-brand-blue-300 transition-colors shadow-lg shadow-brand-blue-400/20"
                >
                  Get My Free Consultation
                </a>
                <a
                  href={`tel:${PHONE_TEL}`}
                  class="w-full sm:w-auto text-center rounded-lg border border-brand-blue-800 px-8 py-4 text-lg font-semibold text-brand-blue-400 hover:border-brand-blue-400 transition-colors"
                >
                  📞 Call {PHONE_DISPLAY}
                </a>
              </div>
              <p class="mt-4 text-sm text-slate-500">
                No pressure. No obligation. If we can't beat your current quote, we'll tell you straight.
              </p>
            </div>

            <!-- Quick Quote Form Card -->
            <div id="quick-quote" class="scroll-mt-24">
              <div class="rounded-2xl border border-brand-blue-800 bg-slate-900 p-6 sm:p-8 shadow-2xl">
                <div class="flex items-center justify-between mb-2">
                  <h2 class="text-2xl font-bold text-white">Get Your Free Quote</h2>
                  <span class="rounded-full bg-brand-green-400/10 px-3 py-1 text-xs font-bold text-brand-green-400">
                    24H RESPONSE
                  </span>
                </div>
                <p class="text-slate-400 mb-6">
                  Tell us a little about the job — we'll call you back with a straight answer, fast.
                </p>

                <form
                  name="quick-quote"
                  method="POST"
                  data-netlify="true"
                  data-netlify-honeypot="bot-field"
                  action="/"
                  class="space-y-4"
                >
                  <input type="hidden" name="form-name" value="quick-quote" />
                  <p class="hidden">
                    <label>
                      Don't fill this out if you're human: <input name="bot-field" />
                    </label>
                  </p>

                  <div>
                    <label for="qq-name" class="block text-sm font-medium text-slate-300 mb-1">
                      Full Name
                    </label>
                    <input
                      id="qq-name"
                      type="text"
                      name="name"
                      required
                      class="w-full rounded-lg border border-brand-blue-800 bg-slate-950 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-brand-blue-400 focus:outline-none focus:ring-1 focus:ring-brand-blue-400"
                      placeholder="John Murphy"
                    />
                  </div>

                  <div class="grid sm:grid-cols-2 gap-4">
                    <div>
                      <label for="qq-phone" class="block text-sm font-medium text-slate-300 mb-1">
                        Phone Number
                      </label>
                      <input
                        id="qq-phone"
                        type="tel"
                        name="phone"
                        required
                        class="w-full rounded-lg border border-brand-blue-800 bg-slate-950 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-brand-blue-400 focus:outline-none focus:ring-1 focus:ring-brand-blue-400"
                        placeholder="087 123 4567"
                      />
                    </div>
                    <div>
                      <label for="qq-location" class="block text-sm font-medium text-slate-300 mb-1">
                        Site Location
                      </label>
                      <input
                        id="qq-location"
                        type="text"
                        name="location"
                        required
                        class="w-full rounded-lg border border-brand-blue-800 bg-slate-950 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-brand-blue-400 focus:outline-none focus:ring-1 focus:ring-brand-blue-400"
                        placeholder="Naas, Co. Kildare"
                      />
                    </div>
                  </div>

                  <div>
                    <label for="qq-service" class="block text-sm font-medium text-slate-300 mb-1">
                      What do you need done?
                    </label>
                    <select
                      id="qq-service"
                      name="service"
                      required
                      class="w-full rounded-lg border border-brand-blue-800 bg-slate-950 px-4 py-3 text-slate-100 focus:border-brand-blue-400 focus:outline-none focus:ring-1 focus:ring-brand-blue-400"
                    >
                      <option value="">Select a service</option>
                      <option value="House Extension">House Extension</option>
                      <option value="Garden Room / Cabin">Garden Room / Cabin</option>
                      <option value="Renovation / Refurbishment">Renovation / Refurbishment</option>
                      <option value="Attic / Garage Conversion">Attic / Garage Conversion</option>
                      <option value="Not Sure / Other">Not Sure / Other</option>
                    </select>
                  </div>

                  <button
                    type="submit"
                    class="w-full rounded-lg bg-brand-blue-400 px-6 py-4 text-lg font-bold text-slate-950 hover:bg-brand-blue-300 transition-colors shadow-lg shadow-brand-blue-400/20"
                  >
                    Get My Free Quote →
                  </button>
                  <p class="text-xs text-center text-slate-500">
                    🔒 Fully insured. We reply within 24 hours, guaranteed.
                  </p>
                </form>
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ GARDEN ROOM TAX CALCULATOR ============ -->
      <section class="border-y border-brand-blue-900 bg-slate-900/60">
        <div class="max-w-5xl mx-auto px-4 py-12 sm:py-16">
          <div class="rounded-2xl border border-brand-blue-800 bg-slate-900 p-6 sm:p-10 shadow-2xl">
            <div class="flex items-start gap-3 mb-3">
              <span class="text-2xl" aria-hidden="true">📌</span>
              <div>
                <span class="text-xs font-bold uppercase tracking-wider text-brand-blue-400">
                  Quick Math
                </span>
                <h2 class="text-2xl sm:text-3xl font-extrabold text-white mt-1">
                  Here's How The Numbers Break Down
                </h2>
              </div>
            </div>
            <p class="text-slate-400 mb-8 max-w-2xl">
              Ireland's Rent-a-Room Relief is being extended to cover garden rooms and cabins — letting
              you earn up to <span class="text-white font-semibold">€14,000 a year, completely tax-free</span>.
              Pop in a rough build cost below and see how fast it could pay for itself.
            </p>

            <div class="grid sm:grid-cols-2 gap-8 items-center">
              <div>
                <label for="calc-cost" class="block text-sm font-medium text-slate-300 mb-2">
                  Estimated build cost
                </label>
                <div class="flex items-center gap-3">
                  <span class="text-2xl font-bold text-brand-blue-400">€</span>
                  <input
                    id="calc-cost"
                    type="number"
                    min="10000"
                    max="250000"
                    step="1000"
                    value="60000"
                    class="w-full rounded-lg border border-brand-blue-800 bg-slate-950 px-4 py-3 text-xl font-bold text-white focus:border-brand-blue-400 focus:outline-none focus:ring-1 focus:ring-brand-blue-400"
                  />
                </div>
                <input
                  id="calc-cost-slider"
                  type="range"
                  min="10000"
                  max="150000"
                  step="1000"
                  value="60000"
                  class="w-full mt-4 accent-brand-blue-400"
                />
                <div class="flex justify-between text-xs text-slate-500 mt-1">
                  <span>€10k</span>
                  <span>€150k</span>
                </div>
              </div>

              <div class="rounded-xl bg-slate-950 border border-brand-blue-800 p-6 text-center">
                <p class="text-sm text-slate-400 mb-1">Paid off in</p>
                <p id="calc-payback" class="text-4xl font-extrabold text-brand-blue-400">—</p>
                <p id="calc-profit" class="text-sm font-semibold mt-3 text-emerald-400">—</p>
              </div>
            </div>

            <div class="mt-8 flex flex-col sm:flex-row items-center gap-4">
              <a
                href="#quick-quote"
                class="w-full sm:w-auto text-center rounded-lg bg-brand-blue-400 px-6 py-3 font-bold text-slate-950 hover:bg-brand-blue-300 transition-colors"
              >
                Get a Garden Room Quote →
              </a>
              <p class="text-xs text-slate-500 max-w-md">
                Estimate only, for illustration. Based on current Rent-a-Room Relief rules (up to
                €14,000/year tax-free). Final Revenue conditions for garden/modular units are still being
                finalised — ask us or your accountant for current guidance.
              </p>
            </div>
          </div>
        </div>
      </section>

      <!-- ============ TRUST BAR ============ -->
      <section class="border-y border-brand-blue-900 bg-slate-900/50">
        <div class="max-w-7xl mx-auto px-4 py-8 grid grid-cols-2 sm:grid-cols-4 gap-6 text-center">
          <div>
            <p class="text-3xl font-extrabold text-brand-blue-400">100%</p>
            <p class="text-sm text-slate-400 mt-1">Fully Insured</p>
          </div>
          <div>
            <p class="text-3xl font-extrabold text-brand-blue-400">24hr</p>
            <p class="text-sm text-slate-400 mt-1">Site Consultation</p>
          </div>
          <div>
            <p class="text-3xl font-extrabold text-brand-blue-400">5.0★</p>
            <p class="text-sm text-slate-400 mt-1">Local Rating</p>
          </div>
          <div>
            <p class="text-3xl font-extrabold text-brand-blue-400">4</p>
            <p class="text-sm text-slate-400 mt-1">Counties Covered</p>
          </div>
        </div>
      </section>

      <!-- ============ SERVICES ============ -->
      <section id="services" class="max-w-7xl mx-auto px-4 py-16 sm:py-24">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">What We Do</span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">
            Extensions & Renovations Built to Last
          </h2>
          <p class="mt-4 text-slate-400">
            From the first design chat to the final coat of paint — we handle every stage with the same
            fixed-price guarantee.
          </p>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
          {services.map((s) => (
            <div class="rounded-xl border border-brand-blue-800 bg-slate-900 p-6 hover:border-brand-blue-400/60 transition-colors">
              <div class="text-4xl mb-4">{s.icon}</div>
              <h3 class="text-lg font-bold text-white mb-2">{s.title}</h3>
              <p class="text-sm text-slate-400">{s.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ WHY CHOOSE US / GUARANTEE ============ -->
      <section class="bg-slate-900 border-y border-brand-blue-900">
        <div class="max-w-7xl mx-auto px-4 py-16 sm:py-24 grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">
              The G Construction Guarantee
            </span>
            <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">
              We Take the Risk, Not You
            </h2>
            <p class="mt-4 text-slate-400">
              Too many extension projects run over budget and over time. We fix that with a simple
              promise: a fixed, written quote before we touch the ground, and a start-to-finish date we
              stick to.
            </p>

            <div class="mt-8 space-y-4">
              <div class="flex items-start gap-4">
                <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-brand-blue-400 text-slate-950 font-bold">
                  1
                </span>
                <div>
                  <h3 class="font-bold text-white">Free Site Consultation, Within 24 Hours</h3>
                  <p class="text-sm text-slate-400">We visit, assess, and get you a straight answer fast — no waiting weeks.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-brand-blue-400 text-slate-950 font-bold">
                  2
                </span>
                <div>
                  <h3 class="font-bold text-white">Fixed-Price, Written Quote</h3>
                  <p class="text-sm text-slate-400">No hidden extras. The price we agree is the price you pay.</p>
                </div>
              </div>
              <div class="flex items-start gap-4">
                <span class="flex h-9 w-9 flex-none items-center justify-center rounded-full bg-brand-blue-400 text-slate-950 font-bold">
                  3
                </span>
                <div>
                  <h3 class="font-bold text-white">On-Time, Every Time</h3>
                  <p class="text-sm text-slate-400">Certified tradespeople and a crew that shows up when we say we will.</p>
                </div>
              </div>
            </div>
          </div>

          <div class="rounded-2xl border border-brand-blue-800 bg-slate-950 p-8">
            <h3 class="text-xl font-bold text-white mb-6">Fully Insured & Certified</h3>
            <ul class="space-y-4">
              <li class="flex items-center gap-3">
                <span class="text-emerald-400 text-xl">✓</span>
                <span class="text-slate-200">Public liability insurance on every job</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-emerald-400 text-xl">✓</span>
                <span class="text-slate-200">Certified tradespeople across every trade</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-emerald-400 text-xl">✓</span>
                <span class="text-slate-200">Compliant with current building regulations</span>
              </li>
              <li class="flex items-center gap-3">
                <span class="text-emerald-400 text-xl">✓</span>
                <span class="text-slate-200">Local crew — we know Kildare, Dublin, Offaly & the Midlands</span>
              </li>
            </ul>
          </div>
        </div>
      </section>

      <!-- ============ COVERAGE AREAS ============ -->
      <section id="coverage" class="max-w-7xl mx-auto px-4 py-16 sm:py-24">
        <div class="text-center max-w-2xl mx-auto mb-12">
          <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">Coverage Areas</span>
          <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">
            Proudly Serving the Midlands & Beyond
          </h2>
          <p class="mt-4 text-slate-400">
            Based locally and on the road daily across these counties — if you're nearby, we can be on
            site fast.
          </p>
        </div>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
          {coverageAreas.map((area) => (
            <div class="rounded-xl border border-brand-blue-800 bg-slate-900 px-4 py-6 text-center hover:border-brand-blue-400/60 transition-colors">
              <span class="text-brand-blue-400 text-xl">📍</span>
              <p class="mt-2 font-semibold text-white">{area}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- ============ DETAILED QUOTE FORM ============ -->
      <section id="detailed-quote" class="bg-slate-900 border-y border-brand-blue-900">
        <div class="max-w-4xl mx-auto px-4 py-16 sm:py-24">
          <div class="text-center mb-10">
            <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">Ready to Start?</span>
            <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">
              Request a Detailed Project Quote
            </h2>
            <p class="mt-4 text-slate-400">
              Give us the full picture and we'll come back with a precise, fixed-price quote — usually
              within 24 hours of visiting site.
            </p>
          </div>

          <div class="rounded-2xl border border-brand-blue-800 bg-slate-950 p-6 sm:p-10 shadow-2xl">
            <form
              name="detailed-quote"
              method="POST"
              data-netlify="true"
              data-netlify-honeypot="bot-field"
              action="/"
              class="space-y-5"
            >
              <input type="hidden" name="form-name" value="detailed-quote" />
              <p class="hidden">
                <label>
                  Don't fill this out if you're human: <input name="bot-field" />
                </label>
              </p>

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="dq-name" class="block text-sm font-medium text-slate-300 mb-1">
                    Full Name
                  </label>
                  <input
                    id="dq-name"
                    type="text"
                    name="name"
                    required
                    class="w-full rounded-lg border border-brand-blue-800 bg-slate-900 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-brand-blue-400 focus:outline-none focus:ring-1 focus:ring-brand-blue-400"
                    placeholder="John Murphy"
                  />
                </div>
                <div>
                  <label for="dq-phone" class="block text-sm font-medium text-slate-300 mb-1">
                    Phone Number
                  </label>
                  <input
                    id="dq-phone"
                    type="tel"
                    name="phone"
                    required
                    class="w-full rounded-lg border border-brand-blue-800 bg-slate-900 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-brand-blue-400 focus:outline-none focus:ring-1 focus:ring-brand-blue-400"
                    placeholder="087 123 4567"
                  />
                </div>
              </div>

              <div class="grid sm:grid-cols-2 gap-5">
                <div>
                  <label for="dq-email" class="block text-sm font-medium text-slate-300 mb-1">
                    Email Address
                  </label>
                  <input
                    id="dq-email"
                    type="email"
                    name="email"
                    required
                    class="w-full rounded-lg border border-brand-blue-800 bg-slate-900 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-brand-blue-400 focus:outline-none focus:ring-1 focus:ring-brand-blue-400"
                    placeholder="you@email.com"
                  />
                </div>
                <div>
                  <label for="dq-location" class="block text-sm font-medium text-slate-300 mb-1">
                    Site Address
                  </label>
                  <input
                    id="dq-location"
                    type="text"
                    name="location"
                    required
                    class="w-full rounded-lg border border-brand-blue-800 bg-slate-900 px-4 py-3 text-slate-100 placeholder-slate-500 focus:border-brand-blue-400 focus:outline-none focus:ring-1 focus:ring-brand-blue-400"
                    placeholder="Site address / eircode"
                  />
                </div>
              </div>

              <div>
                <label for="dq-service" class="block text-sm font-medium text-slate-300 mb-1">
                  Service Required
                </label>
                <select
