---
import { SHOW_REVIEWS, reviews } from '../consts';
---

{SHOW_REVIEWS && reviews.length > 0 && (
  <section class="bg-slate-900 border-y border-brand-blue-900">
    <div class="max-w-7xl mx-auto px-4 py-16 sm:py-24">
      <div class="text-center max-w-2xl mx-auto mb-12">
        <span class="text-sm font-bold uppercase tracking-wider text-brand-blue-400">Reviews</span>
        <h2 class="mt-3 text-3xl sm:text-4xl font-extrabold text-white">What Customers Say</h2>
      </div>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {reviews.map((r) => (
          <div class="rounded-xl border border-brand-blue-800 bg-slate-950 p-6">
            <div class="text-brand-blue-400 mb-2">{'★'.repeat(r.rating)}{'☆'.repeat(5 - r.rating)}</div>
            <p class="text-slate-300 text-sm mb-4">"{r.quote}"</p>
            <p class="text-white font-semibold text-sm">{r.name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
